# Zyntaverse Technologies Environment Configuration Template
# Duplicate this file to .env.local for local overrides

# Base Site URL (Used for Canonical URLs, OpenGraph, Sitemap)
NEXT_PUBLIC_SITE_URL=https://www.zyntaverse.com

# Official Contact Details
NEXT_PUBLIC_CONTACT_EMAIL=zyntaversetechnologies@gmail.com
NEXT_PUBLIC_WHATSAPP_PHONE=917992153750

# Optional Analytics / Tracking (Google Analytics / Vercel Analytics)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Webhook / Email Service (Resend / Formspree)
# CONTACT_FORM_WEBHOOK_URL=https://api.resend.com/emails
